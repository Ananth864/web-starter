{
  "name": "web-starter",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.6.7",
      "typescript": "^7.0.2",
      "lucide-react": "^1.59.0",
      "next-themes": "^0.4.6",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "sonner": "^2.0.8",
      "tailwindcss": "^4.3.3",
      "convex": "^1.47.0",
      "@workos/authkit-tanstack-react-start": "^0.11.1",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "alchemy": "2.0.0-beta.83",
      "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
      "vite-plus": "1.3.0",
      "effect": "^4.0.5",
      "@clerk/tanstack-react-start": "^1.7.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vp run -r --parallel dev",
    "dev:web": "vp run --filter web dev",
    "dev:server": "vp run --filter @web-starter/backend dev",
    "dev:setup": "vp run --filter @web-starter/backend dev:setup",
    "codegen": "vp run --filter @web-starter/backend codegen",
    "build": "vp run -r build",
    "check": "vp check",
    "fix": "vp check --fix",
    "deploy": "vp run --filter web deploy",
    "destroy": "vp run --filter web destroy",
    "init": "bun scripts/init.ts"
  },
  "dependencies": {
    "@web-starter/env": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/node": "^26.6.5",
    "@web-starter/config": "workspace:*",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "bun@1.3.14"
}
